<?xml version="1.0" encoding="utf-8"?>
<!--
  F-Droid + GitHub releases flavour (§10.2, §15.1). This file, together with
  src/play/AndroidManifest.xml, must be the ONLY place the two flavours
  diverge (D13) — the CI manifest-diff check (§17.5b) enforces this.

  Note: the design doc's §15.1 layout names this src/fossMain/ — that suffix
  does not match AGP's actual flavor source-set convention (a flavor's own
  source set is src/<flavorName>/, not src/<flavorName>Main/; "Main" only
  appears in combined variant source sets like src/fossDebug/). Corrected
  here; see docs/adr/0001-flavor-source-set-naming.md.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- API 33+, auto-granted; no Play Console declaration needed outside Play. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

</manifest>
