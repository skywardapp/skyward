-- §11: reminder rules (§9). location_ids_json = null means "all saved locations".
CREATE TABLE rule (
  id TEXT PRIMARY KEY, name TEXT NOT NULL, enabled INTEGER NOT NULL,
  phenomena_json TEXT NOT NULL, location_ids_json TEXT,
  condition_json TEXT NOT NULL, schedule_json TEXT NOT NULL,
  hidden INTEGER NOT NULL DEFAULT 0,
  created_at TEXT NOT NULL, modified_at TEXT NOT NULL
);

selectAll:
SELECT * FROM rule ORDER BY created_at ASC;

selectVisible:
SELECT * FROM rule WHERE hidden = 0 ORDER BY created_at ASC;

selectEnabled:
SELECT * FROM rule WHERE enabled = 1;

selectById:
SELECT * FROM rule WHERE id = ?;

upsert:
INSERT OR REPLACE INTO rule(id, name, enabled, phenomena_json, location_ids_json, condition_json, schedule_json, hidden, created_at, modified_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateEnabled:
UPDATE rule SET enabled = ?, modified_at = ? WHERE id = ?;

deleteById:
DELETE FROM rule WHERE id = ?;
